---
layout: null
permalink: /search.json
---
[
{% for post in site.posts %}
  {% assign section_title = '日记与感想' %}{% for section in site.data.blog.sections %}{% if section.id == post.section %}{% assign section_title = section.title %}{% endif %}{% endfor %}
  {"title": {{ post.title | jsonify }}, "url": {{ post.url | relative_url | jsonify }}, "date": {{ post.date | date: '%Y.%m.%d' | jsonify }}, "section": {{ post.section | jsonify }}, "section_title": {{ section_title | jsonify }}, "tags": {{ post.tags | jsonify }}, "description": {{ post.description | default: post.excerpt | strip_html | normalize_whitespace | truncate: 120 | jsonify }}, "content": {{ post.content | strip_html | normalize_whitespace | jsonify }}}{% unless forloop.last %},{% endunless %}
{% endfor %}
]
